# Copy this file to .env and fill in the values. Never commit .env (constitution IV).

# Database host as seen from the api container ("db" in Docker Compose, "localhost" when running on the host)
DB_HOST=
# Database port (MariaDB default: 3306)
DB_PORT=
# Name of the application database
DB_NAME=
# Database user the API connects with
DB_USER=
# Password of DB_USER; choose a long random value
DB_PASSWORD=
# Root password of the MariaDB container; only used by the container itself
DB_ROOT_PASSWORD=
# Name of the separate database used by the automated tests (profile "test")
TEST_DB_NAME=
# Port the API listens on inside its container (nginx proxies /api/ to it)
API_PORT=
# Directory for uploaded files (logos end up in <UPLOADS_DIR>/logos/); /data/uploads in Docker
UPLOADS_DIR=
# "true" in production (HTTPS only). Set to "false" only for local HTTP development without nginx
COOKIE_SECURE=
# Minutes of inactivity after which a session expires (default 60, FR-019).
# Only lower this temporarily for manual testing, then set it back to 60.
SESSION_IDLE_TIMEOUT_MINUTES=
